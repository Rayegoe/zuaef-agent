# Quant Telegram event bridge — one oneshot consumption tick.
# Scans the material-alert stream under .zuaef-state/quant-bridge/ (cursor +
# delivery), sends material events to Telegram, exits. One tick may include up
# to one Agent run; a hung run must not wedge the timer schedule forever, hence
# TimeoutStartSec.
# Credentials come from repo .env (AgentSettings.from_env()) — never inline.
# If api.telegram.org is unreachable directly, set ZUAEF_PROXY when running the
# installer: it writes a proxy.conf drop-in for this unit.
[Unit]
Description=Quant Telegram event bridge — one oneshot consumption tick
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/zuaef-agent
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/zuaef-agent/.venv/bin/python %h/zuaef-agent/tools/quant_telegram_bridge.py
TimeoutStartSec=900