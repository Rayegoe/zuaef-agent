{"id": "T001", "name": "return_to_observation", "condition": ["段落以抽象概念或评价性语言推进，缺少可验证支点", "材料中已有可观察事实未被使用"], "action": "return_to_observation", "instruction": "回到已检索材料，选出一个可验证的具体观察（人物动作、物件、数字、原话），让下一段围绕它展开；用观察替代抽象概括。", "preserve": ["claims", "source_ledger"], "anti_pattern": ["abstract_restatement", "invented_detail"], "domain": ["nonfiction"], "sources": ["sanlian-135464", "sanlian-172807"], "primary_source": "sanlian-172807", "confidence": {"level": "medium", "basis": ["curated_methodology", "multi_source_agreement"]}, "activation": {"mode": "hybrid", "trigger_signals": ["abstract_noun_density"], "context_signals": ["material_observed"], "situation_tags": ["drafting", "nonfiction"]}, "rationale": "三联生产方法强调坚实输入与现场：抽象推进时回到材料的具体观察，是编辑部反复出现的修正动作。"}
{"id": "T002", "name": "delay_interpretation", "condition": ["解释性语句紧随事实出现，段落以意义收尾", "叙事推进过早停止"], "action": "delay_interpretation", "instruction": "让下一个事实、场景或矛盾先出现，再考虑解释；不在段尾总结意义。", "preserve": ["claims", "source_ledger"], "anti_pattern": ["premature_summary"], "domain": ["nonfiction"], "sources": ["sanlian-173292", "sanlian-189000"], "primary_source": "sanlian-173292", "confidence": {"level": "medium", "basis": ["curated_methodology"]}, "activation": {"mode": "sensor", "trigger_signals": ["summary_pressure"], "context_signals": [], "situation_tags": ["drafting", "nonfiction"]}, "rationale": "深度报道方法论：事实先行的节奏控制，解释延后到证据落地。"}
{"id": "T003", "name": "question_chain", "condition": ["局部答案使推进失去动力", "结构塌缩为并列清单"], "action": "break_trajectory", "instruction": "把刚获得的局部答案转换成下一层问题，用问题链驱动结构推进。", "preserve": [], "anti_pattern": ["flat_enumeration"], "domain": ["nonfiction"], "sources": ["sanlian-189000"], "primary_source": "sanlian-189000", "confidence": {"level": "medium", "basis": ["curated_methodology"]}, "activation": {"mode": "context", "trigger_signals": [], "context_signals": ["mid_draft_progression_stalled"], "situation_tags": ["drafting", "nonfiction"]}, "rationale": "袁越方法：以问题链维持读者的推进动力，答案只是下一问的台阶。"}
{"id": "T004", "name": "scene_as_entry", "condition": ["开篇或新段落以概念或背景切入", "知识性段落缺少落点"], "action": "return_to_observation", "instruction": "从真实现场、人物动作或具体事件进入，再逐步展开知识与背景。", "preserve": ["claims", "source_ledger"], "anti_pattern": ["concept_first_opening"], "domain": ["nonfiction"], "sources": ["sanlian-172190", "sanlian-189000"], "primary_source": "sanlian-189000", "confidence": {"level": "medium", "basis": ["curated_methodology", "editor_best_practice"]}, "activation": {"mode": "hybrid", "trigger_signals": ["low_concrete_anchor_density"], "context_signals": ["section_opening"], "situation_tags": ["drafting", "nonfiction"]}, "rationale": "年度好稿点评与袁越方法共同的入口判断：现场先于概念。"}
{"id": "T005", "name": "material_before_style", "condition": ["语言润色占用推进时间但信息密度不增", "缺少采访、数据、原话或现场材料"], "action": "retrieve_concrete_memory", "instruction": "停止润色，回到材料补采访要点、数据、原话或现场细节，再继续写作。", "preserve": ["claims", "source_ledger"], "anti_pattern": ["polish_without_input"], "domain": ["nonfiction"], "sources": ["sanlian-140982", "sanlian-172807"], "primary_source": "sanlian-172807", "confidence": {"level": "medium", "basis": ["curated_methodology", "multi_source_agreement"]}, "activation": {"mode": "hybrid", "trigger_signals": ["low_concrete_anchor_density"], "context_signals": ["material_observed"], "situation_tags": ["drafting", "nonfiction"]}, "rationale": "内部写作培训与主编生产方法一致：输入质量决定输出上限，先补材料再谈文字。"}
{"id": "T006", "name": "person_through_choice", "condition": ["人物被抽象标签定义", "人物缺少可感的具体性"], "action": "return_to_observation", "instruction": "用行为、选择、代价与关系呈现人物，替代性格标签。", "preserve": ["claims", "source_ledger"], "anti_pattern": ["trait_labeling"], "domain": ["nonfiction"], "sources": ["sanlian-135464"], "primary_source": "sanlian-135464", "confidence": {"level": "medium", "basis": ["curated_methodology"]}, "activation": {"mode": "hybrid", "trigger_signals": ["abstract_noun_density"], "context_signals": ["material_observed"], "situation_tags": ["drafting", "nonfiction"]}, "rationale": "人物写作课核心观察：让人物从具体情景中出现，标签不能代替选择。"}
{"id": "T007", "name": "history_person_coupling", "condition": ["大段背景与人物处境脱节"], "action": "shift_perspective", "instruction": "仅当背景改变人物处境、选择或理解时引入历史/背景，并把视角落回人物。", "preserve": ["claims", "source_ledger"], "anti_pattern": ["detached_background_dump"], "domain": ["nonfiction"], "sources": ["sanlian-135464"], "primary_source": "sanlian-135464", "confidence": {"level": "medium", "basis": ["curated_methodology"]}, "activation": {"mode": "context", "trigger_signals": [], "context_signals": ["background_material_available"], "situation_tags": ["drafting", "nonfiction"]}, "rationale": "人物故事写作观察：历史材料必须与人物命运耦合才有叙事位置。"}
{"id": "T008", "name": "tree_structure", "condition": ["线性清单式推进", "读者失去结构位置"], "action": "break_trajectory", "instruction": "建立主干问题与分支知识的树状结构，允许回到主干，形成空间感而非流水线。", "preserve": [], "anti_pattern": ["linear_listing"], "domain": ["nonfiction"], "sources": ["sanlian-172190", "sanlian-189000"], "primary_source": "sanlian-172190", "confidence": {"level": "medium", "basis": ["curated_methodology", "multi_source_agreement"]}, "activation": {"mode": "hybrid", "trigger_signals": ["uniform_paragraphs"], "context_signals": ["structure_planning"], "situation_tags": ["drafting", "nonfiction"]}, "rationale": "主编点评与袁越方法共有的结构判断：知识以树状组织而非顺序罗列。"}
{"id": "T009", "name": "structure_changes_with_material", "condition": ["段落节奏均一但材料性质已变化"], "action": "break_trajectory", "instruction": "在材料性质真正变化处拆分、合并或改变结构动作；结构随材料而变，不随固定节奏。", "preserve": [], "anti_pattern": ["fixed_cadence_splitting"], "domain": ["nonfiction"], "sources": ["sanlian-172190"], "primary_source": "sanlian-172190", "confidence": {"level": "medium", "basis": ["curated_methodology"]}, "activation": {"mode": "sensor", "trigger_signals": ["uniform_paragraphs"], "context_signals": [], "situation_tags": ["drafting", "nonfiction"]}, "rationale": "年度好稿结构观察：分段位置由材料变化决定，均质分段是模板轨迹的表层症状。"}
{"id": "T010", "name": "exemplar_extract_move_not_surface", "condition": ["研读范文后出现表层句式模仿倾向"], "action": "return_to_observation", "instruction": "只保留从范文提取的结构动作与判断方式，随即回到自己的材料重写该段。", "preserve": ["claims", "source_ledger"], "anti_pattern": ["surface_imitation", "style_copy"], "domain": ["nonfiction"], "sources": ["sanlian-163167", "sanlian-200872"], "primary_source": "sanlian-200872", "confidence": {"level": "medium", "basis": ["curated_methodology", "course_feedback_loop"]}, "activation": {"mode": "context", "trigger_signals": [], "context_signals": ["exemplar_observed"], "situation_tags": ["drafting", "nonfiction"]}, "rationale": "写作三部曲与书评训练闭环的共同纪律：范文提供动作，不提供句子。"}
{"id": "T011", "name": "minimal_patch", "condition": ["需要修订但影响范围不明"], "action": "break_trajectory", "instruction": "定位能完成修订意图的最小编辑范围；明确 claims 与 source ledger 保持不变，只改动该范围。", "preserve": ["claims", "source_ledger", "facts"], "anti_pattern": ["whole_document_rewrite"], "domain": ["nonfiction", "academic"], "sources": ["iterater", "tetra"], "primary_source": "iterater", "confidence": {"level": "high", "basis": ["research_findings", "multi_source_agreement"]}, "activation": {"mode": "context", "trigger_signals": [], "context_signals": ["revision_requested", "save_boundary"], "situation_tags": ["drafting", "nonfiction"]}, "rationale": "IteraTeR/TETRA 人工修订的共同形态：编辑以局部 span 完成，不重写全文。"}
{"id": "T012", "name": "intent_before_edit", "condition": ["收到修订请求但意图未分类"], "action": "break_trajectory", "instruction": "先把编辑意图分类（clarity/fluency/coherence/style 等），再选择对应的局部动作。", "preserve": ["claims", "source_ledger"], "anti_pattern": ["unclassified_editing"], "domain": ["nonfiction", "academic"], "sources": ["iterater"], "primary_source": "iterater", "confidence": {"level": "high", "basis": ["research_findings"]}, "activation": {"mode": "context", "trigger_signals": [], "context_signals": ["revision_requested"], "situation_tags": ["drafting", "nonfiction"]}, "rationale": "IteraTeR 的核心标签体系：人工修订总是先有意图分类，再有编辑动作。"}
{"id": "T013", "name": "coherence_over_sentence_polish", "condition": ["句子各自通顺但衔接跳跃"], "action": "break_trajectory", "instruction": "调整句序与关系衔接，而不是继续润色单个句子。", "preserve": ["claims", "source_ledger"], "anti_pattern": ["sentence_level_polishing_only"], "domain": ["nonfiction", "academic"], "sources": ["re3", "tetra"], "primary_source": "tetra", "confidence": {"level": "high", "basis": ["research_findings", "multi_source_agreement"]}, "activation": {"mode": "hybrid", "trigger_signals": ["uniform_paragraphs"], "context_signals": ["revision_requested"], "situation_tags": ["drafting", "nonfiction"]}, "rationale": "TETRA 编辑类型与 Re3 修订标注共同显示：coherence 修订作用于顺序与关系，非句子表面。"}
{"id": "T014", "name": "preference_is_conditioned", "condition": ["把某个版本的偏好当作普遍规则"], "action": "shift_perspective", "instruction": "先核对 genre、audience、task intent 等条件，再决定该偏好是否适用于当前文本。", "preserve": ["claims", "source_ledger"], "anti_pattern": ["unconditioned_taste_rule"], "domain": ["nonfiction", "creative"], "sources": ["wpb"], "primary_source": "wpb", "confidence": {"level": "high", "basis": ["research_findings"]}, "activation": {"mode": "context", "trigger_signals": [], "context_signals": ["preference_evidence_available"], "situation_tags": ["drafting", "nonfiction"]}, "rationale": "WritingPreferenceBench 结论：偏好在客观因素匹配下采集；taste 是条件化的，不是标量规则。"}
{"id": "T015", "name": "no_intervention_when_evidence_weak", "condition": ["信号弱或证据不足时出现干预冲动"], "action": "delay_interpretation", "instruction": "信号不足时选择不干预：让文本继续或直接通过保存，把判断留给更强的证据。", "preserve": [], "anti_pattern": ["over_editing"], "domain": ["nonfiction"], "sources": ["tetra", "wpb"], "primary_source": "tetra", "confidence": {"level": "medium", "basis": ["research_findings", "editorial_negative_case"]}, "activation": {"mode": "context", "trigger_signals": [], "context_signals": ["save_boundary", "weak_signals"], "situation_tags": ["drafting", "nonfiction"]}, "rationale": "专业编辑后的文本不需要再编辑；benchmark T10 负样本对应的能力侧纪律：知道何时不动。"}
{"id": "T016", "name": "feedback_to_structured_memory", "condition": ["获得执行反馈但尚未结构化"], "action": "return_to_observation", "instruction": "把反馈转成 trigger/action/rationale/before-after/outcome/provenance 的结构化经验记录。", "preserve": [], "anti_pattern": ["unstructured_feedback_retention"], "domain": ["nonfiction", "agent_ops"], "sources": ["ace", "reflexion"], "primary_source": "reflexion", "confidence": {"level": "high", "basis": ["research_findings", "multi_source_agreement"]}, "activation": {"mode": "context", "trigger_signals": [], "context_signals": ["feedback_available"], "situation_tags": ["drafting", "nonfiction"]}, "rationale": "Reflexion 与 ACE 共同机制：反馈结构化为可检索经验后才改变后续行为。"}
{"id": "T017", "name": "incremental_context_update", "condition": ["经验库需要更新"], "action": "break_trajectory", "instruction": "以增量方式添加、合并或降权单条经验；不整体重写经验库。", "preserve": [], "anti_pattern": ["full_context_rewrite"], "domain": ["nonfiction", "agent_ops"], "sources": ["ace"], "primary_source": "ace", "confidence": {"level": "high", "basis": ["research_findings"]}, "activation": {"mode": "context", "trigger_signals": [], "context_signals": ["feedback_available"], "situation_tags": ["drafting", "nonfiction"]}, "rationale": "ACE 的 playbook 演化方式：增量 curation，保持可追溯与可回滚。"}
{"id": "T018", "name": "human_patch_outweighs_seed", "condition": ["检索到与场景匹配的人工 patch 与通用 seed 同时存在"], "action": "shift_perspective", "instruction": "优先采用经过验证、场景匹配的人工 patch；seed 仅在无匹配时使用。", "preserve": [], "anti_pattern": ["seed_over_patch"], "domain": ["nonfiction", "agent_ops"], "sources": ["ace", "reflexion"], "primary_source": "ace", "confidence": {"level": "high", "basis": ["research_findings", "multi_source_agreement"]}, "activation": {"mode": "context", "trigger_signals": [], "context_signals": ["evidence_available"], "situation_tags": ["drafting", "nonfiction"]}, "rationale": "ACE/Reflexion 的经验分层：具体验证过的经验优先于通用初始化规则。"}
{"id": "T019", "name": "feedback_scope_match", "condition": ["外部评审或反馈到达"], "action": "break_trajectory", "instruction": "先判定反馈的真实作用范围（句/段/结构/全文），只在该范围内修改。", "preserve": ["claims", "source_ledger"], "anti_pattern": ["scope_overreach_edit"], "domain": ["nonfiction", "academic"], "sources": ["re3"], "primary_source": "re3", "confidence": {"level": "high", "basis": ["research_findings"]}, "activation": {"mode": "context", "trigger_signals": [], "context_signals": ["review_received"], "situation_tags": ["drafting", "nonfiction"]}, "rationale": "Re3-Sci 标注显示：评审触发的修订有明确作用粒度，越界修改不是常态。"}
{"id": "T020", "name": "preserve_claims_during_style_edit", "condition": ["风格修订可能触碰事实层"], "action": "retrieve_concrete_memory", "instruction": "先把 claims 与 source refs 列为不可变边界，再执行局部风格 patch；不增删事实。", "preserve": ["claims", "source_ledger", "facts"], "anti_pattern": ["fact_drift", "fabricate_scene"], "domain": ["nonfiction", "academic"], "sources": ["iterater", "re3", "tetra"], "primary_source": "iterater", "confidence": {"level": "high", "basis": ["research_findings", "multi_source_agreement"]}, "activation": {"mode": "hybrid", "trigger_signals": ["template_connectors"], "context_signals": ["claim_checked", "save_boundary"], "situation_tags": ["drafting", "nonfiction"]}, "rationale": "三套修订数据集共同边界：风格与流畅修订不得改变事实与引用。"}
