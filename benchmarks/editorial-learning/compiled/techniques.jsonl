{"action":"break_trajectory","activation":{"context_signals":[],"mode":"sensor","situation_tags":["drafting","nonfiction"],"trigger_signals":["uniform_paragraphs"]},"anti_pattern":["fixed_cadence_splitting"],"condition":["段落节奏均一但材料性质已变化"],"confidence":{"basis":["curated_methodology"],"level":"medium"},"domain":["nonfiction"],"id":"T009","instruction":"在材料性质真正变化处拆分、合并或改变结构动作；结构随材料而变，不随固定节奏。","name":"structure_changes_with_material","node_id":"techniques/T009","preserve":[],"primary_source":"sanlian-172190","rationale":"年度好稿结构观察：分段位置由材料变化决定，均质分段是模板轨迹的表层症状。","sources":["sanlian-172190"]}
{"action":"return_to_observation","activation":{"context_signals":["exemplar_observed"],"mode":"context","situation_tags":["drafting","nonfiction"],"trigger_signals":[]},"anti_pattern":["style_copy","surface_imitation"],"condition":["研读范文后出现表层句式模仿倾向"],"confidence":{"basis":["course_feedback_loop","curated_methodology"],"level":"medium"},"domain":["nonfiction"],"id":"T010","instruction":"只保留从范文提取的结构动作与判断方式，随即回到自己的材料重写该段。","name":"exemplar_extract_move_not_surface","node_id":"techniques/T010","preserve":["claims","source_ledger"],"primary_source":"sanlian-200872","rationale":"写作三部曲与书评训练闭环的共同纪律：范文提供动作，不提供句子。","sources":["sanlian-163167","sanlian-200872"]}
{"action":"break_trajectory","activation":{"context_signals":["revision_requested","save_boundary"],"mode":"context","situation_tags":["drafting","nonfiction"],"trigger_signals":[]},"anti_pattern":["whole_document_rewrite"],"condition":["需要修订但影响范围不明"],"confidence":{"basis":["multi_source_agreement","research_findings"],"level":"high"},"domain":["academic","nonfiction"],"id":"T011","instruction":"定位能完成修订意图的最小编辑范围；明确 claims 与 source ledger 保持不变，只改动该范围。","name":"minimal_patch","node_id":"techniques/T011","preserve":["claims","facts","source_ledger"],"primary_source":"iterater","rationale":"IteraTeR/TETRA 人工修订的共同形态：编辑以局部 span 完成，不重写全文。","sources":["iterater","tetra"]}
{"action":"break_trajectory","activation":{"context_signals":["revision_requested"],"mode":"context","situation_tags":["drafting","nonfiction"],"trigger_signals":[]},"anti_pattern":["unclassified_editing"],"condition":["收到修订请求但意图未分类"],"confidence":{"basis":["research_findings"],"level":"high"},"domain":["academic","nonfiction"],"id":"T012","instruction":"先把编辑意图分类（clarity/fluency/coherence/style 等），再选择对应的局部动作。","name":"intent_before_edit","node_id":"techniques/T012","preserve":["claims","source_ledger"],"primary_source":"iterater","rationale":"IteraTeR 的核心标签体系：人工修订总是先有意图分类，再有编辑动作。","sources":["iterater"]}
