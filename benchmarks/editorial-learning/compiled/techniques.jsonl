{"action":"return_to_observation","activation":{"context_signals":["material_observed"],"mode":"hybrid","situation_tags":["drafting","nonfiction"],"trigger_signals":["abstract_noun_density"]},"anti_pattern":["abstract_restatement","invented_detail"],"condition":["材料中已有可观察事实未被使用","段落以抽象概念或评价性语言推进，缺少可验证支点"],"confidence":{"basis":["curated_methodology","multi_source_agreement"],"level":"medium"},"domain":["nonfiction"],"id":"T001","instruction":"回到已检索材料，选出一个可验证的具体观察（人物动作、物件、数字、原话），让下一段围绕它展开；用观察替代抽象概括。","name":"return_to_observation","node_id":"techniques/T001","preserve":["claims","source_ledger"],"primary_source":"sanlian-172807","rationale":"三联生产方法强调坚实输入与现场：抽象推进时回到材料的具体观察，是编辑部反复出现的修正动作。","sources":["sanlian-135464","sanlian-172807"]}
{"action":"delay_interpretation","activation":{"context_signals":[],"mode":"sensor","situation_tags":["drafting","nonfiction"],"trigger_signals":["summary_pressure"]},"anti_pattern":["premature_summary"],"condition":["叙事推进过早停止","解释性语句紧随事实出现，段落以意义收尾"],"confidence":{"basis":["curated_methodology"],"level":"medium"},"domain":["nonfiction"],"id":"T002","instruction":"让下一个事实、场景或矛盾先出现，再考虑解释；不在段尾总结意义。","name":"delay_interpretation","node_id":"techniques/T002","preserve":["claims","source_ledger"],"primary_source":"sanlian-173292","rationale":"深度报道方法论：事实先行的节奏控制，解释延后到证据落地。","sources":["sanlian-173292","sanlian-189000"]}
{"action":"break_trajectory","activation":{"context_signals":["mid_draft_progression_stalled"],"mode":"context","situation_tags":["drafting","nonfiction"],"trigger_signals":[]},"anti_pattern":["flat_enumeration"],"condition":["局部答案使推进失去动力","结构塌缩为并列清单"],"confidence":{"basis":["curated_methodology"],"level":"medium"},"domain":["nonfiction"],"id":"T003","instruction":"把刚获得的局部答案转换成下一层问题，用问题链驱动结构推进。","name":"question_chain","node_id":"techniques/T003","preserve":[],"primary_source":"sanlian-189000","rationale":"袁越方法：以问题链维持读者的推进动力，答案只是下一问的台阶。","sources":["sanlian-189000"]}
