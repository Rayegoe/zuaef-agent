{"action":"retrieve_concrete_memory","activation":{"context_signals":["material_observed"],"mode":"hybrid","situation_tags":["drafting","nonfiction"],"trigger_signals":["low_concrete_anchor_density"]},"anti_pattern":["polish_without_input"],"condition":["缺少采访、数据、原话或现场材料","语言润色占用推进时间但信息密度不增"],"confidence":{"basis":["curated_methodology","multi_source_agreement"],"level":"medium"},"domain":["nonfiction"],"id":"T005","instruction":"停止润色，回到材料补采访要点、数据、原话或现场细节，再继续写作。","name":"material_before_style","node_id":"techniques/T005","preserve":["claims","source_ledger"],"primary_source":"sanlian-172807","rationale":"内部写作培训与主编生产方法一致：输入质量决定输出上限，先补材料再谈文字。","sources":["sanlian-140982","sanlian-172807"]}
{"action":"return_to_observation","activation":{"context_signals":["material_observed"],"mode":"hybrid","situation_tags":["drafting","nonfiction"],"trigger_signals":["abstract_noun_density"]},"anti_pattern":["trait_labeling"],"condition":["人物缺少可感的具体性","人物被抽象标签定义"],"confidence":{"basis":["curated_methodology"],"level":"medium"},"domain":["nonfiction"],"id":"T006","instruction":"用行为、选择、代价与关系呈现人物，替代性格标签。","name":"person_through_choice","node_id":"techniques/T006","preserve":["claims","source_ledger"],"primary_source":"sanlian-135464","rationale":"人物写作课核心观察：让人物从具体情景中出现，标签不能代替选择。","sources":["sanlian-135464"]}
