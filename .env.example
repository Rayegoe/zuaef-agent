# Official PydanticAI model identifier. Explicit is better than magic auto-detection.
ZUAEF_MODEL=openai:gpt-5.2
ZUAEF_WORKSPACE=./workspace
ZUAEF_REQUEST_LIMIT=12
ZUAEF_TOOL_CALLS_LIMIT=40
# Optional total-token budget per run (integer > 0).
# ZUAEF_TOTAL_TOKENS_LIMIT=200000

# v1.1 runtime guards. Defaults shown.
ZUAEF_ENABLE_PLANNING=true
ZUAEF_ENABLE_SKILLS=true
ZUAEF_ENABLE_TOOL_OUTPUT_LIMITS=true
ZUAEF_ENABLE_STEP_PERSISTENCE=true
ZUAEF_MAX_SNAPSHOTS_PER_RUN=8

# Caller-owned durable delivery root (host setting, generic). Must resolve
# outside ZUAEF_WORKSPACE. After a completed run, the host copies the
# receipt-listed artifacts here (CLI: run --delivery-root), so the deliverables
# survive cleanup of the runtime workspace.
# ZUAEF_DELIVERY_ROOT=/var/lib/zuaef/delivery

# ── Generalist host ceiling (Phase 2, SPEC v1.0 §3) ──────────────────────────
# These are the process/environment ceiling: whether the HOST may ever expose a
# generalist capability. The effective deployment authorization is
#
#     effective = host ceiling ∩ profile [generalist] request
#
# computed by the composition layer and frozen into the CompositionSnapshot.
# Available ≠ authorized ≠ loaded ≠ invoked. A deployment requests what it
# needs in its profile; the model never decides either half.
# Defaults are the narrow business surface: every flag below is OFF unless the
# host enables it here.
ZUAEF_ENABLE_TOOL_SEARCH=true        # ToolSearch-driven progressive disclosure
ZUAEF_ENABLE_MEMORY=true             # Memory capability (upstream primitive)
ZUAEF_ENABLE_CONVERSATION_SEARCH=true
ZUAEF_ENABLE_CONTEXT_CONTROLS=true
ZUAEF_ENABLE_SUBAGENTS=true          # SubAgent delegation (upstream primitive)
# Web is a host decision; some deployments deny it even with web in the profile.
# ZUAEF_ENABLE_WEB_SEARCH=true
# ZUAEF_ENABLE_WEB_FETCH=true
# Shell / repo-context stay OFF for business deployments (stillevo-fde never
# requests them, and this host ceiling is the outer guard even if a profile did).
# ZUAEF_ENABLE_SHELL=true
# ZUAEF_ENABLE_REPO_CONTEXT=true

# Optional: OpenAI-compatible endpoint (DeepSeek-compatible gateway, local gateway, etc.).
# When set, ZUAEF_COMPAT_MODEL is the raw model name expected by that endpoint.
# ZUAEF_OPENAI_BASE_URL=https://example.com/v1
# ZUAEF_OPENAI_API_KEY=...
# ZUAEF_COMPAT_MODEL=your-model-name

# Optional runtime-state root. Defaults to a sibling of the workspace: ./.zuaef-state
# Keeping this outside ZUAEF_WORKSPACE prevents model-facing filesystem tools from mutating their own logs/receipts.
# ZUAEF_STATE_ROOT=./.zuaef-state

# ── stillevo-fde deployment (Phase 2 product seam) ───────────────────────────
# The FDE profile composes real business plugins. Non-secret site config lives
# in the profile; secrets belong here (never in a profile/snapshot/receipt).
# ACE Context Engine checkout (ace_root) — required by plugins/zuaef-ace-writing:
# ACE_ROOT=/path/to/article-context-engine
# WordPress site credentials — required by plugins/zuaef-wordpress:
# ZUAEF_WORDPRESS_USERNAME=...
# ZUAEF_WORDPRESS_APP_PASSWORD=...
#
# Authoritative Phase-2 proof (GatewayService + stillevo-fde + bound real Case):
#   uv run python tools/fde_two_turn_proof.py

# ── Telegram gateway (Phase 3A supervisor console) ───────────────────────────
# The long-poll gateway process. Mandatory, comma-separated user-id allowlist —
# startup fails closed when empty; private chats only. Allowlisted users are
# the supervisors: they run the deterministic control plane (/case, /cases,
# /unbind, buttons) and approve/deny external effects. The model is never an
# authorization source and can never bind a Case.
# TELEGRAM_BOT_TOKEN=...
# ZUAEF_TELEGRAM_ALLOWED_USERS=123456789
