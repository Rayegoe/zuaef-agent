workspace/artifacts/
# Private/derived knowledge the model may write stays out of the public repo;
# only index.md / concepts/* already committed are tracked (gitignore never
# untracks them). Blocks future untracked real knowledge from git add.
workspace/knowledge/
.state-proof/
# Editorial-learning benchmark: raw datasets (hundreds of MB, fetched by
# benchmarks/editorial-learning/scripts/fetch_sources.py) and derived full
# texts are local-only; committed assets carry bounded excerpts + hashes.
data/
.venv-quant/
# ARM64 wheel the Orange Pi installer builds (ops/install_orangepi_node.sh);
# rebuildable on any RK3588 board, never versioned as a binary.
.arm-wheels/

# installer backups
.env.bak-*
