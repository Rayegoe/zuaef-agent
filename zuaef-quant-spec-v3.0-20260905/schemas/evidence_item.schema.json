{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvidenceItem",
  "type": "object",
  "required": [
    "evidence_id",
    "kind",
    "available_at",
    "ingested_at",
    "source_id",
    "pit_status"
  ],
  "properties": {
    "evidence_id": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "symbol": {
      "type": [
        "string",
        "null"
      ]
    },
    "event_time": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_time": {
      "type": [
        "string",
        "null"
      ]
    },
    "available_at": {
      "type": "string"
    },
    "ingested_at": {
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "pit_status": {
      "enum": [
        "PASS",
        "CONTAMINATED",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ]
    },
    "payload": {
      "type": "object"
    }
  }
}
