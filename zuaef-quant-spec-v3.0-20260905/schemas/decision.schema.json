{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QuantDecision",
  "type": "object",
  "required": [
    "decision_id",
    "mode",
    "decision_time",
    "decision",
    "reason_codes",
    "strategy_version",
    "gate_states"
  ],
  "properties": {
    "decision_id": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "production",
        "shadow",
        "replay"
      ]
    },
    "symbol": {
      "type": [
        "string",
        "null"
      ]
    },
    "decision_time": {
      "type": "string"
    },
    "decision": {
      "enum": [
        "BUY",
        "NO_BUY",
        "HOLD",
        "EXIT",
        "NO_TRADE",
        "NOT_RUN_TODAY"
      ]
    },
    "trigger": {
      "type": [
        "string",
        "null"
      ]
    },
    "market_regime": {
      "type": [
        "string",
        "null"
      ]
    },
    "strategy_version": {
      "type": "string"
    },
    "data_snapshot_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "gate_states": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "frozen": {
      "type": "boolean"
    }
  }
}
