{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReplayRun",
  "type": "object",
  "required": [
    "replay_run_id",
    "strategy_version",
    "start_date",
    "end_date",
    "state",
    "evidence_namespace"
  ],
  "properties": {
    "replay_run_id": {
      "type": "string"
    },
    "strategy_version": {
      "type": "string"
    },
    "start_date": {
      "type": "string"
    },
    "end_date": {
      "type": "string"
    },
    "cadence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "state": {
      "enum": [
        "PLANNED",
        "RUNNING",
        "COMPLETED",
        "FAILED",
        "DEGRADED"
      ]
    },
    "evidence_namespace": {
      "const": "replay"
    },
    "trading_days": {
      "type": "integer",
      "minimum": 0
    },
    "trigger_count": {
      "type": "integer",
      "minimum": 0
    },
    "settled_count": {
      "type": "integer",
      "minimum": 0
    },
    "pit_block_count": {
      "type": "integer",
      "minimum": 0
    },
    "pipeline_failure_count": {
      "type": "integer",
      "minimum": 0
    }
  }
}
