{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ForwardObservation",
  "type": "object",
  "required": [
    "observation_id",
    "namespace",
    "created_at",
    "decision_time",
    "symbol",
    "decision_id",
    "state"
  ],
  "properties": {
    "observation_id": {
      "type": "string"
    },
    "namespace": {
      "enum": [
        "live_forward",
        "replay",
        "shadow"
      ]
    },
    "created_at": {
      "type": "string"
    },
    "decision_time": {
      "type": "string"
    },
    "symbol": {
      "type": "string"
    },
    "decision_id": {
      "type": "string"
    },
    "state": {
      "enum": [
        "CREATED",
        "FROZEN",
        "DUE",
        "SETTLED",
        "INVALIDATED"
      ]
    },
    "entry_price": {
      "type": [
        "number",
        "null"
      ]
    },
    "market_regime": {
      "type": [
        "string",
        "null"
      ]
    },
    "candidate_score": {
      "type": [
        "number",
        "null"
      ]
    },
    "trigger_reason_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gate_states": {
      "type": "object"
    },
    "outcome": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}
